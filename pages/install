#!/bin/sh
# typdoc installer (POSIX sh) for macOS and Linux.
#
# Hosted at https://typdoc.thaitype.dev/install and meant to be piped into a shell:
#
#   curl -fsSL https://typdoc.thaitype.dev/install | sh
#
# Hand-written rather than generated by cargo-dist's own shell installer: that generated script
# bakes one fixed version into itself at generation time (no runtime version selection at all)
# and has no config knob to change that, so it cannot serve as this single, permanently-hosted
# script that resolves a version every time it runs. cargo-dist still builds and checksums the
# release archives this script downloads; only the installer itself is hand-written.
#
# Environment variables (end-user facing, see README/docs/getting-started.md):
#   TYPDOC_VERSION   Install this exact release tag (e.g. "v0.3.1") instead of the latest one.
#   INSTALL_DIR      Install into this directory instead of the default ("$HOME/.local/bin").
#
# Environment variables for testing only — never documented anywhere else, and not a supported
# interface: do not rely on this staying stable.
#   TYPDOC_INSTALL_BASE_URL   Overrides the base URL archives/checksums are fetched from, so CI
#                             can point this script at a local HTTP server before any real
#                             release exists yet. A comment here (and the story's own contract)
#                             are this variable's only documentation, on purpose.
#
# This script never edits PATH or any shell rc file. If the install directory isn't already on
# PATH, it prints the one line to run and exits 0 anyway — installation still succeeded.

set -u

REPO_OWNER="thaitype"
REPO_NAME="typdoc"
APP_NAME="typdoc"

say() {
    printf '%s\n' "$*"
}

err() {
    printf 'error: %s\n' "$*" 1>&2
    exit 1
}

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || err "missing required command: $1"
}

# Downloads $1 to $2 using curl if available, falling back to wget.
download() {
    _url="$1"
    _dest="$2"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$_url" -o "$_dest"
    elif command -v wget >/dev/null 2>&1; then
        wget -q "$_url" -O "$_dest"
    else
        err "need curl or wget to download ${APP_NAME}"
    fi
}

# Prints the sha256 hex digest of $1, trying whichever tool is available.
sha256_of() {
    _file="$1"
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$_file" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$_file" | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$_file" | awk '{print $NF}'
    else
        err "need sha256sum, shasum, or openssl to verify the downloaded archive"
    fi
}

# Sets TARGET to one of the five release target triples, or exits with an unsupported-platform
# error. Never falls back to a "closest" target.
detect_target() {
    _os="$(uname -s)"
    _arch="$(uname -m)"

    case "$_os" in
        Linux) _os_id=linux ;;
        Darwin) _os_id=macos ;;
        *) err "unsupported platform: $_os ($_arch) has no prebuilt ${APP_NAME} binary; see README for other install options" ;;
    esac

    case "$_arch" in
        x86_64 | amd64) _arch_id=x86_64 ;;
        arm64 | aarch64) _arch_id=aarch64 ;;
        *) err "unsupported platform: $_os on $_arch has no prebuilt ${APP_NAME} binary; see README for other install options" ;;
    esac

    case "${_os_id}-${_arch_id}" in
        linux-x86_64) TARGET=x86_64-unknown-linux-musl ;;
        linux-aarch64) TARGET=aarch64-unknown-linux-musl ;;
        macos-x86_64) TARGET=x86_64-apple-darwin ;;
        macos-aarch64) TARGET=aarch64-apple-darwin ;;
        *) err "unsupported platform: $_os ($_arch) has no prebuilt ${APP_NAME} binary; see README for other install options" ;;
    esac
}

main() {
    need_cmd uname
    need_cmd mktemp
    need_cmd tar
    need_cmd awk

    detect_target
    _archive_name="${APP_NAME}-${TARGET}.tar.gz"

    base_url="${TYPDOC_INSTALL_BASE_URL:-https://github.com/${REPO_OWNER}/${REPO_NAME}}"

    # TYPDOC_VERSION pins an exact tag. Otherwise resolve "latest" via GitHub's own
    # releases/latest/download redirect — never the unauthenticated REST API, which is
    # rate-limited per-IP and collides across shared CI runners.
    if [ -n "${TYPDOC_VERSION:-}" ]; then
        _download_prefix="${base_url}/releases/download/${TYPDOC_VERSION}"
    else
        _download_prefix="${base_url}/releases/latest/download"
    fi

    _archive_url="${_download_prefix}/${_archive_name}"
    _checksum_url="${_archive_url}.sha256"

    _tmpdir="$(mktemp -d)"
    trap 'rm -rf "$_tmpdir"' EXIT INT TERM HUP

    _archive_path="${_tmpdir}/${_archive_name}"
    _checksum_path="${_archive_path}.sha256"

    say "downloading ${APP_NAME} (${TARGET}) from ${_archive_url}"
    download "$_archive_url" "$_archive_path" || err "failed to download ${_archive_url}"
    download "$_checksum_url" "$_checksum_path" || err "failed to download ${_checksum_url}"

    _expected="$(awk '{print $1}' "$_checksum_path" 2>/dev/null || true)"
    [ -n "$_expected" ] || err "checksum file at ${_checksum_url} was empty or unreadable"
    _actual="$(sha256_of "$_archive_path")"

    if [ "$_expected" != "$_actual" ]; then
        err "checksum mismatch for ${_archive_name}
  expected: ${_expected}
  actual:   ${_actual}
nothing was installed."
    fi

    tar xzf "$_archive_path" --strip-components 1 -C "$_tmpdir" || err "failed to extract ${_archive_name}"

    _bin_src="${_tmpdir}/${APP_NAME}"
    [ -f "$_bin_src" ] || err "archive did not contain the expected '${APP_NAME}' binary"

    if [ -n "${INSTALL_DIR:-}" ]; then
        install_dir="$INSTALL_DIR"
    elif [ -n "${HOME:-}" ]; then
        install_dir="${HOME}/.local/bin"
    else
        err "\$HOME is not set; set INSTALL_DIR to choose where to install ${APP_NAME}"
    fi

    mkdir -p "$install_dir" || err "could not create install directory: ${install_dir}"
    cp "$_bin_src" "${install_dir}/${APP_NAME}" || err "could not copy ${APP_NAME} into ${install_dir}"
    chmod +x "${install_dir}/${APP_NAME}"

    say "installed ${APP_NAME} to ${install_dir}/${APP_NAME}"

    case ":${PATH}:" in
        *":${install_dir}:"*) ;;
        *)
            say ""
            say "${install_dir} is not on your PATH. Add it by running:"
            say ""
            say "    export PATH=\"${install_dir}:\$PATH\""
            ;;
    esac
}

main
